-- ================================
-- STATE
-- ================================
local Enabled = true
local JumpByMoveDirection = true -- OFF máº·c Äá»nh
local ButtonTransparency = 0.55

--HighJump

local function UpJump(power)
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    hum.PlatformStand = false
    hum:ChangeState(Enum.HumanoidStateType.Jumping)

    root.AssemblyLinearVelocity =
        Vector3.new(root.AssemblyLinearVelocity.X, power, root.AssemblyLinearVelocity.Z)
end

-- ================================
-- TRANSPARENCY LOGIC
-- ================================
local function UpdateButtonTransparency()
    JumpButton.BackgroundTransparency = ButtonTransparency
    JumpButton.TextTransparency = ButtonTransparency

    if Menu.Visible then
        ToggleButton.BackgroundTransparency = 0.35
        ToggleButton.TextTransparency = 0
    else
        ToggleButton.BackgroundTransparency = ButtonTransparency
        ToggleButton.TextTransparency = ButtonTransparency
    end
end

TransFill.Size = UDim2.new(1 - ButtonTransparency,0,1,0)
PercentLabel.Text = math.floor((1 - ButtonTransparency) * 100) .. "%"
UpdateButtonTransparency()

-- ================================
-- RAGDOLL (FIX DOUBLE JUMP BUG)
-- ================================
local Ragdolling = false
local HeartbeatConn
local ragdollToken = 0 -- ID cho mÃÂÃÂ¡ÃÂÃÂ»ÃÂÃÂi lÃÂÃÂ¡ÃÂÃÂºÃÂÃÂ§n ragdoll

local function StopRagdoll(hum)
    Ragdolling = false
    if HeartbeatConn then
        HeartbeatConn:Disconnect()
        HeartbeatConn = nil
    end
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function StartRagdoll(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    ragdollToken += 1
    local myToken = ragdollToken

    StopRagdoll(hum)

    -- 🔴🔴🔴 RESET ROTATION X/Z 1 LẦN DUY NHẤT (ĐẶT ĐÚNG CHỖ) 🔴🔴🔴
    root.AssemblyAngularVelocity = Vector3.zero

    local pos = root.Position
    local _, y, _ = root.CFrame:ToEulerAnglesYXZ()
    root.CFrame = CFrame.new(pos) * CFrame.Angles(0, y, 0)
    -- 🔴🔴🔴 HẾT RESET 🔴🔴🔴

    Ragdolling = true

    HeartbeatConn = RunService.Heartbeat:Connect(function()
        if not Ragdolling then return end
        hum.PlatformStand = true
        hum:ChangeState(Enum.HumanoidStateType.Physics)
    end)

    task.delay(Setting.RagdollTime, function()
        if myToken ~= ragdollToken then return end
        StopRagdoll(hum)
    end)
end

-- ================================
-- JUMP
-- ================================
local function DoJump()
    if not Enabled then return end

    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local rad = math.rad(Setting.UpAngle)
local moveDir

if JumpByMoveDirection and hum.MoveDirection.Magnitude > 0.1 then
    -- MODE MOVE: giữ nguyên (có Y theo UpAngle)
    moveDir = hum.MoveDirection.Unit
else
    -- MODE CAM: CHỈ lấy hướng ngang
    local camLook = workspace.CurrentCamera.CFrame.LookVector
    moveDir = Vector3.new(camLook.X, 0, camLook.Z)

    if moveDir.Magnitude < 0.01 then
        moveDir = Vector3.new(0, 0, -1)
    end

    moveDir = moveDir.Unit
end

local dir = (moveDir * math.cos(rad) + Vector3.new(0, math.sin(rad), 0)).Unit

-- KHÔNG cho Jumping
hum.PlatformStand = true
hum:ChangeState(Enum.HumanoidStateType.Physics)

-- đẩy lực trực tiếp
root.AssemblyLinearVelocity = dir * Setting.ForwardJumpSpeed

-- ragdoll ngay, không delay
StartRagdoll(char)
end

