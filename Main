-- ===== GUI BUTTON =====
-- HIGH JUMP (tap = cÃÂÃÂ© | hold = mÃÂ¡ÃÂ»ÃÂi)
local holding = false
local holdStart = 0
local holdUsed = false

local function StartHold()
    if holding or not Enabled then return end
    holding = true
    holdUsed = false
    holdStart = tick()

    task.spawn(function()
        local singleDone = false

        while holding do
            local t = tick() - holdStart

            -- giÃÂ¡ÃÂ»ÃÂ¯ >= 0.25s ÃÂ¢ÃÂÃÂ nhÃÂ¡ÃÂºÃÂ£y thÃÂ¡ÃÂºÃÂ³ng lÃÂÃÂªn 1 lÃÂ¡ÃÂºÃÂ§n
            if t >= Setting.HoldSingleTime and not singleDone then
                UpJump(Setting.HoldJumpPower)
                singleDone = true
                holdUsed = true
            end

            -- giÃÂ¡ÃÂ»ÃÂ¯ >= 1s ÃÂ¢ÃÂÃÂ nhÃÂ¡ÃÂºÃÂ£y liÃÂÃÂªn tÃÂ¡ÃÂ»ÃÂ¥c
            if t >= Setting.HoldLoopTime then
                UpJump(Setting.HoldJumpPower)
                task.wait(Setting.HoldLoopDelay)
            else
                task.wait()
            end
        end
    end)
end

local function StopHold()
    if not holding then return end
    holding = false

    -- bÃÂ¡ÃÂºÃÂ¥m nhanh ÃÂ¢ÃÂÃÂ dÃÂÃÂ¹ng High Jump cÃÂÃÂ©
    if not holdUsed and Enabled then
        DoJump()
    end
end

-- HIGH JUMP BUTTON
JumpButton.MouseButton1Down:Connect(StartHold)
JumpButton.MouseButton1Up:Connect(StopHold)
JumpButton.MouseLeave:Connect(StopHold)

-- ===== MENU / OTHER BUTTONS =====
local lastClick = 0
ToggleButton.MouseButton1Click:Connect(function()
    local now = tick()
    Menu.Visible = not Menu.Visible
    UpdateButtonTransparency()

    -- double click ÃÂÃÂÃÂ¡ÃÂ»ÃÂ bÃÂ¡ÃÂºÃÂ­t / tÃÂ¡ÃÂºÃÂ¯t
    if now - lastClick < 0.25 then
        Enabled = not Enabled
        JumpButton.Visible = Enabled
    end
    lastClick = now
end)

BT.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    BT.Text = Enabled and "b" or "t"
    JumpButton.Visible = Enabled
end)

ModeBT.MouseButton1Click:Connect(function()
    JumpByMoveDirection = not JumpByMoveDirection
    ModeBT.Text = JumpByMoveDirection and "MOVE" or "CAM"
end)

FlyBT.MouseButton1Click:Connect(function()
    loadstring(game:HttpGet("https://rawscripts.net/raw/Universal-Script-Fly-gui-54742"))()
end)

CopyBT.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(CONFIG_TEXT)
        CopyBT.Text = "✓"
        task.delay(0.8, function()
            CopyBT.Text = "C"
        end)
    else
        warn("Executor khÃÂ´ng hÃ¡Â»Â trÃ¡Â»Â£ copy clipboard")
    end
end)

SpeedBox.FocusLost:Connect(function()
    local v = tonumber(SpeedBox.Text)
    if v then Setting.ForwardJumpSpeed = v end
end)

AngleBox.FocusLost:Connect(function()
    local v = tonumber(AngleBox.Text)
    if v then Setting.UpAngle = math.clamp(v, 5, 80) end
end)

-- ===== KEYBOARD =====
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode[Setting.JumpKey] then
        StartHold()
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode[Setting.JumpKey] then
        StopHold()
    end
end)

-- ================================
-- SLIDER (PC + MOBILE)
-- ================================
local dragging = false

local function UpdateFromInput(input)
    local pos = math.clamp(
        (input.Position.X - TransBar.AbsolutePosition.X) / TransBar.AbsoluteSize.X,
        0, 1
    )
    ButtonTransparency = 1 - pos
    TransFill.Size = UDim2.new(pos,0,1,0)
    PercentLabel.Text = math.floor(pos * 100) .. "%"
    UpdateButtonTransparency()
end

TransBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        UpdateFromInput(input)
    end
end)

TransBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        UpdateFromInput(input)
    end
end)
